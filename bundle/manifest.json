          "prefix": "⚡",
          "color": "accent"
        },
        {
          "id": "cache-hit",
          "statusKey": "cache-hit",
          "position": "right",
          "selfColorize": true
        },
        {
          "id": "ds-balance",
          "statusKey": "ds-balance",
          "position": "right",
          "selfColorize": true
        }
      ],
      "layout": {
        "left": [
          "path",
          "git",
          "model",
          "thinking",
          "shell_mode",
          "custom:context-bar",
          "cost",
          "custom:ds-balance"
