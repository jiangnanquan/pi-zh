{
  "schema": 1,
  "name": "pi 扩展协同环境",
  "description": "一套验证过可协同工作的 pi 扩展组合 + 汉化入口（由 pi-zh 维护线 E 从维护者本机导出）",
  "exported_at": "2026-09-13",
  "exported_by": "pi-zh/scripts/export_bundle.sh（E 线：本机白名单提取）",
  "packages": [
    {
      "spec": "npm:pi-subagents",
      "note": "多子 agent 编排与并行任务；当前启动成本最高的扩展（实测 +177ms，约占总加载成本 43%）"
    },
    {
      "spec": "npm:@juicesharp/rpiv-todo",
      "note": "todo 工具（扩展版）"
    },
    {
      "spec": "npm:@juicesharp/rpiv-ask-user-question",
      "note": "结构化提问工具（ask_user_question）"
    },
    {
      "spec": "npm:pi-deepseek-search",
      "note": "DeepSeek 联网搜索（需 DeepSeek 凭据；无凭据时仅该工具不可用，不阻塞启动）"
    },
    {
      "spec": "npm:pi-cc-extensions",
      "note": "Claude Code 风格扩展包（startup header / 全屏交互等）"
    },
    {
      "spec": "npm:cc-safety-net",
      "note": "命令安全网（危险命令拦截）"
    },
    {
      "spec": "npm:pi-powerline-footer",
      "note": "底部状态栏 + 欢迎页；4 个自研扩展段与 C 线补丁的宿主"
    }
  ],
  "settings": {
    "quietStartup": true,
    "tuiMode": "fullscreen",
    "powerline": {
      "customItems": [
        {
          "id": "context-bar",
          "statusKey": "context-bar",
